#
# c3l - reproducible dependencies for C3 projects, on top of `c3c fetch`.
#
# c3c installs libraries; c3l keeps the books: a lockfile (c3l.lock), checksum
# verification with rollback, update/outdated/remove/sync.

set -o pipefail
[[ -n "$DEBUGC3L" ]] && set -x

VERSION="1.1.0"
PROGRAM="${0##*/}"
C3C="${C3C:-c3c}"
LOCK="${C3L_LOCK:-c3l.lock}"
OLDRECORDS=".c3l.deps"
DEFAULT_REGISTRY="https://www.c3pkg.eu"
TAB=$'\t'

REGISTRY_OPT=""
DRY_RUN=0
FROZEN=0
NOLOCKWRITE=0
PROJECT=""
TMPROOT=""
TXN=""
TXN_NAME=""
TXN_DIR=""
INSTALL_ROLE=direct; FORCE=0; TREE=0
LAST_NAME=""; LAST_REQS=""; REQ_NAMES="-"
STACK=(); DEP_COUNT=0; DEP_MAX="${C3L_MAX_DEPS:-200}"
STRICT=0; ALLOW_DIRTY=0; NO_BUILD=0; OFFLINE=0
TOKEN_FILE=""; PKG_VERSION=""; C3_VERSION_OPT=""; OUTPUT_OPT=""
DESC_OPT=""; LICENSE_OPT=""; TAGS_OPT=""; DOCS_OPT=""; GIT_OPT=""; REGISTRY_TYPE_OPT=""

#
# Output
#
if [[ -t 1 ]]; then C_G=$'\e[32m'; C_Y=$'\e[33m'; C_R=$'\e[31m'; C_0=$'\e[0m'; else C_G=""; C_Y=""; C_R=""; C_0=""; fi
info() { printf '%s[INFO]%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
die()  { printf '%s[ERROR]%s %s\n' "$C_R" "$C_0" "$*" >&2; [[ "${BASHPID:-$$}" == "$$" ]] && op_rollback; exit 1; }

#
# Utilities
#
tmproot() {
	[[ -n "$TMPROOT" ]] && return 0
	TMPROOT="$(mktemp -d "${TMPDIR:-/tmp}/c3l.XXXXXXXX")" || die "cannot create a temporary directory"
	trap 'rm -rf "$TMPROOT"' EXIT
}

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required for this command but was not found"; }

sha256_file() {
	if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
	elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
	else die "neither sha256sum nor shasum found"; fi
}

# Read one member of a zip to stdout (unzip, else python3).
zip_read() {
	if command -v unzip >/dev/null 2>&1; then unzip -p "$1" "$2" 2>/dev/null
	elif command -v python3 >/dev/null 2>&1; then
		python3 -c 'import sys,zipfile; sys.stdout.write(zipfile.ZipFile(sys.argv[1]).read(sys.argv[2]).decode())' "$1" "$2" 2>/dev/null
	else return 1; fi
}

json_string_field() { # key  (reads JSON on stdin, first match)
	sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
}

valid_semver() { [[ "$1" =~ ^v?[0-9]+(\.[0-9]+){0,2}(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; }

# semver_cmp A B -> prints -1, 0 or 1 (semver 2.0 precedence, build metadata ignored)
semver_cmp() {
	local a="${1#v}" b="${2#v}"
	a="${a%%+*}"; b="${b%%+*}"
	local acore="${a%%-*}" bcore="${b%%-*}" apre="" bpre="" x y i n
	[[ "$a" == *-* ]] && apre="${a#*-}"
	[[ "$b" == *-* ]] && bpre="${b#*-}"
	local -a ac bc ap bp
	IFS=. read -ra ac <<< "$acore"
	IFS=. read -ra bc <<< "$bcore"
	for i in 0 1 2; do
		x=$((10#${ac[i]:-0})); y=$((10#${bc[i]:-0}))
		(( x > y )) && { echo 1; return; }
		(( x < y )) && { echo -1; return; }
	done
	[[ -z "$apre" && -z "$bpre" ]] && { echo 0; return; }
	[[ -z "$apre" ]] && { echo 1; return; }
	[[ -z "$bpre" ]] && { echo -1; return; }
	IFS=. read -ra ap <<< "$apre"
	IFS=. read -ra bp <<< "$bpre"
	n=${#ap[@]}; (( ${#bp[@]} > n )) && n=${#bp[@]}
	for (( i = 0; i < n; i++ )); do
		x="${ap[i]}"; y="${bp[i]}"
		[[ -z "$x" ]] && { echo -1; return; }
		[[ -z "$y" ]] && { echo 1; return; }
		if [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
			(( 10#$x > 10#$y )) && { echo 1; return; }
			(( 10#$x < 10#$y )) && { echo -1; return; }
		elif [[ "$x" =~ ^[0-9]+$ ]]; then echo -1; return
		elif [[ "$y" =~ ^[0-9]+$ ]]; then echo 1; return
		else
			[[ "$x" > "$y" ]] && { echo 1; return; }
			[[ "$x" < "$y" ]] && { echo -1; return; }
		fi
	done
	echo 0
}
semver_gt() { valid_semver "$1" && valid_semver "$2" && [[ "$(semver_cmp "$1" "$2")" == 1 ]]; }

#
# Project access (all through c3c, never by guessing)
#
find_project() {
	local f
	for f in project.json project.json5; do
		[[ -f "$f" ]] && { PROJECT="$f"; return 0; }
	done
	if [[ -f manifest.json ]]; then
		die "$PWD is a library directory (it has manifest.json, no project.json). This command manages the libraries of a project; to release this library use '$PROGRAM check' and '$PROGRAM publish'."
	fi
	die "no project.json found in $PWD. Run c3l from the project root (create one with 'c3c init' or 'c3l init <name>')."
}

project_view() { "$C3C" project view 2>/dev/null; }

lib_dir() {
	local line first
	line="$(project_view | sed -n 's/^c3l library search paths: *//p' | head -n 1)"
	first="${line%%,*}"
	first="${first#"${first%%[![:space:]]*}"}"
	first="${first%"${first##*[![:space:]]}"}"
	[[ -n "$first" && "$first" != "*none*" ]] || die "no entry in dependency-search-paths in $PROJECT"
	printf '%s\n' "$first"
}

deps_list() {
	local line
	line="$(project_view | sed -n 's/^c3l library dependencies: *//p' | head -n 1)"
	[[ "$line" == "*none*" ]] && return 0
	tr ',' '\n' <<< "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed '/^$/d'
}

in_deps() { deps_list | grep -qx -- "$1"; }

# deps_edit add|del NAME: edit the top-level "dependencies" array of the project
# file. Tokenizer-based (understands strings, // and /* */ comments, nesting),
# touches nothing else. Result is checked against `c3c project view`.
AWK_DEPS='
function ws(c) { return (c==" " || c=="\t" || c=="\n" || c=="\r") }
function skipws(p,   c) {
	while (p <= n) {
		c = substr(s,p,1)
		if (ws(c)) p++
		else if (c=="/" && substr(s,p+1,1)=="/") { while (p<=n && substr(s,p,1)!="\n") p++ }
		else if (c=="/" && substr(s,p+1,1)=="*") { p+=2; while (p<=n && substr(s,p,2)!="*/") p++; p+=2 }
		else break
	}
	return p
}
function readstr(p,   q, out, c) {
	q = substr(s,p,1); out = ""; p++
	while (p <= n) {
		c = substr(s,p,1)
		if (c=="\\") { out = out substr(s,p,2); p+=2; continue }
		if (c==q) break
		out = out c; p++
	}
	endpos = p
	return out
}
{ s = s $0 "\n" }
END {
	n = length(s); depth = 0; p = 1; found = 0; cnt = 0
	while (p <= n) {
		c = substr(s,p,1)
		if (c=="/" && (substr(s,p+1,1)=="/" || substr(s,p+1,1)=="*")) { p = skipws(p); continue }
		if (c=="\"" || c=="\047") {
			key = readstr(p); e = endpos
			if (depth==1 && key=="dependencies") {
				q = skipws(e+1)
				if (substr(s,q,1)==":") {
					q = skipws(q+1)
					if (substr(s,q,1)=="[") {
						found = 1; astart = q; r = q+1
						while (r <= n) {
							r = skipws(r); d = substr(s,r,1)
							if (d=="]") break
							if (d=="\"" || d=="\047") { items[++cnt] = readstr(r); r = endpos+1; continue }
							r++
						}
						aend = r
						break
					}
				}
			}
			p = e+1; continue
		}
		if (c=="{" || c=="[") depth++
		else if (c=="}" || c=="]") depth--
		p++
	}
	m = 0; present = 0
	for (i = 1; i <= cnt; i++) {
		if (items[i] == name) { present = 1; if (op=="del") continue }
		keep[++m] = items[i]
	}
	if (op=="add" && !present) keep[++m] = name
	list = "[ "
	for (i = 1; i <= m; i++) list = list (i>1 ? ", " : "") "\"" keep[i] "\""
	list = list (m ? " ]" : "]")
	if (found) { printf "%s%s%s", substr(s,1,astart-1), list, substr(s,aend+1) }
	else if (op=="add") { i = index(s,"{"); printf "%s\n  \"dependencies\": %s,%s", substr(s,1,i), list, substr(s,i+1) }
	else printf "%s", s
}
'
deps_edit() {
	local op="$1" name="$2" tmp="$PROJECT.c3l.tmp.$$"
	awk -v op="$op" -v name="$name" "$AWK_DEPS" "$PROJECT" > "$tmp" || { rm -f "$tmp"; die "failed to edit $PROJECT"; }
	if cmp -s "$tmp" "$PROJECT"; then rm -f "$tmp"; return 0; fi
	cat "$tmp" > "$PROJECT" && rm -f "$tmp"
	if [[ "$op" == add ]]; then in_deps "$name" || return 1
	else in_deps "$name" && return 1; fi
	return 0
}

#
# Lockfile: TSV, one library per line
#   name <TAB> kind <TAB> source <TAB> version <TAB> pin <TAB> hash (registry: sha256 of the file; git: the commit)
#        <TAB> role (direct = asked for by the project, dep = pulled in by another library)
#        <TAB> requires (comma separated names this library requires, "-" if none)
#   @registry <TAB> url   (header)
#
lock_registry() { [[ -f "$LOCK" ]] && awk -F'\t' '$1=="@registry"{print $2; exit}' "$LOCK"; return 0; }
lock_entries()  { # always 8 fields; short (older) lines are filled in
	[[ -f "$LOCK" ]] && awk -F'\t' 'BEGIN{OFS="\t"} $0 !~ /^#/ && $1 !~ /^@/ && NF>=5 { if (NF<6) $6=$5; if (NF<7) $7="direct"; if (NF<8) $8="-"; print }' "$LOCK"
	return 0
}
lock_get()      { lock_entries | awk -F'\t' -v n="$1" '$1==n{print; exit}'; }

lock_write() { # reads entries on stdin, writes header + sorted entries
	local reg="$1" tmp="$LOCK.tmp.$$"
	{
		printf '# c3l.lock v1 - written by c3l, do not edit by hand\n'
		[[ -n "$reg" ]] && printf '@registry\t%s\n' "$reg"
		LC_ALL=C sort
	} > "$tmp" && mv "$tmp" "$LOCK" || die "cannot write $LOCK"
}

# role: direct | dep | keep. direct always wins; dep keeps the role of an existing entry
# (a direct library stays direct); keep restores/updates without changing the role.
lock_put() { # name kind source version pin hash [role] [requires]
	(( NOLOCKWRITE )) && return 0
	local name="$1" role="${7:-direct}" reqs="$8" old oldrole oldreqs reg
	old="$(lock_get "$name")"
	if [[ -n "$old" ]]; then
		IFS=$'\t' read -r _ _ _ _ _ _ oldrole oldreqs <<< "$old"
		[[ "$role" == direct ]] || role="$oldrole"
		[[ -n "$reqs" ]] || reqs="$oldreqs"
	elif [[ "$role" == keep ]]; then role=direct
	fi
	[[ -n "$reqs" ]] || reqs="-"
	reg="$(lock_registry)"
	[[ "$2" == registry && -z "$reg" ]] && reg="$(registry)"
	{ lock_entries | awk -F'\t' -v n="$name" '$1!=n'; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$role" "$reqs"; } | lock_write "$reg"
}

lock_del() {
	[[ -f "$LOCK" ]] || return 0
	lock_entries | awk -F'\t' -v n="$1" '$1!=n' | lock_write "$(lock_registry)"
}

#
# Registry
#
registry() {
	local r
	if [[ -n "$REGISTRY_OPT" ]]; then r="$REGISTRY_OPT"
	elif [[ -n "$C3L_REGISTRY" ]]; then r="$C3L_REGISTRY"
	else r="$(lock_registry)"; [[ -n "$r" ]] || r="$DEFAULT_REGISTRY"; fi
	printf '%s\n' "${r%/}"
}

c3_has_fetch() { # (captured first: grep -q would SIGPIPE c3c and trip pipefail)
	local out
	out="$("$C3C" --help 2>&1)"
	[[ "$out" == *fetch-info* ]]
}
c3fetch() { "$C3C" --fetch-url "$(registry)" "$@"; }

is_registry_id() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
is_git_url()     { [[ "$1" == *://* || "$1" == git@* || "$1" == /* || "$1" == ./* || "$1" == ../* ]]; }

# parsers for the documented `c3c fetch-info` output (stdin = that text)
info_latest()      { awk '/^Latest:/{print $2; exit}'; }
info_has_version() { awk -v v="$1" '/^Versions:/{inv=1; next} inv && /^  [^ ]/ && $1==v {f=1} END{exit !f}'; }
info_checksum()    { awk -v v="$1" '/^Versions:/{inv=1; next} inv && /^  [^ ]/{cur=$1} inv && /^    Checksum:/ && cur==v {print $2; exit}'; }

registry_info() { # id -> text on stdout
	c3_has_fetch || die "this c3c has no 'fetch-info'. Install a c3c with registry support (0.8.6 or a nightly)."
	c3fetch fetch-info "$1" 2>&1 || { printf '%s\n' "$1: not found or registry not reachable ($(registry))" >&2; return 1; }
}

#
# Transactions: every install can be rolled back (project file, lockfile, libraries)
#
txn_begin() { op_begin; op_backup "$1"; TXN_DIR="$OP_LIBDIR"; }
txn_rollback() { op_rollback; }
txn_fail() { op_rollback; die "$@ (rolled back)"; }

#
# Installers
#
check_collision() { # name kind source
	local rec kind source
	rec="$(lock_get "$1")"
	[[ -z "$rec" ]] && return 0
	IFS=$'\t' read -r _ kind source _ <<< "$rec"
	[[ "$kind" == "$2" && "$source" == "$3" ]] && return 0
	die "'$1' is already installed from $kind:$source. Library names are global in a project; run 'c3l remove $1' first."
}

install_registry_one() { # id version(optional) pin(optional)
	local id="$1" want="$2" pin="$3" name="${1##*/}" text sum expected dir file got prov
	check_collision "$name" registry "$id"
	text="$(registry_info "$id")" || die "cannot read info for $id"
	[[ -n "$want" ]] || want="$(info_latest <<< "$text")"
	[[ -n "$want" ]] || die "registry returned no latest version for $id"
	info_has_version "$want" <<< "$text" || die "no such version '$want' for $id"
	if [[ -z "$pin" ]]; then   # a pinned (lock) restore must stay reproducible
		compat_check "$id" "$want"
		(( STRICT && COMPAT_WARNED )) && die "$id@$want is not compatible with this toolchain (--strict)"
	fi
	sum="$(info_checksum "$want" <<< "$text")"
	expected="$pin"; [[ -n "$expected" ]] || expected="$sum"
	if [[ -n "$pin" && -n "$sum" && "$pin" != "$sum" ]]; then
		warn "registry checksum for $id@$want differs from c3l.lock (immutable versions must never change)"
	fi
	[[ -n "$expected" ]] || warn "registry gave no checksum for $id@$want; recording the downloaded file (trust on first use)"

	find_project
	txn_begin "$name"
	dir="$TXN_DIR"; file="$dir/$name.c3l"
	[[ -d "$file" ]] && rm -rf "$file"
	info "fetching $id@$want from $(registry)"
	c3fetch --decompress=no fetch "$id@$want" || txn_fail "c3c fetch failed for $id@$want"
	[[ -f "$file" ]] || txn_fail "c3c did not install $file"
	got="sha256:$(sha256_file "$file")"
	if [[ -n "$expected" && "$got" != "$expected" ]]; then
		txn_fail "checksum mismatch for $id@$want: expected $expected, got $got"
	fi
	prov="$(zip_read "$file" manifest.json | json_string_field provides)"
	[[ -z "$prov" || "$prov" == "$name" ]] || warn "manifest of $id provides '$prov', c3c will register it as '$name'"
	in_deps "$name" || { deps_edit add "$name" || txn_fail "could not register $name in $PROJECT"; }
	local role="$INSTALL_ROLE"; [[ -n "$pin" ]] && role=keep
	read_reqs "$name" "$file"
	lock_put "$name" registry "$id" "$want" "$got" "$got" "$role" "$REQ_NAMES"
	info "installed $name $want ($got)"
}

git_tags() { # url -> "tag commit" lines (annotated tags peeled)
	git ls-remote --tags "$1" 2>/dev/null | awk '{
		ref=$2; sub("refs/tags/","",ref); peeled=0
		if (ref ~ /\^\{\}$/) { sub(/\^\{\}$/,"",ref); peeled=1 }
		if (peeled) c[ref]=$1; else if (!(ref in c)) c[ref]=$1
	} END { for (r in c) print r " " c[r] }'
}
git_highest_tag() { # url
	local best="" t _c
	while read -r t _c; do
		valid_semver "$t" || continue
		if [[ -z "$best" ]] || semver_gt "$t" "$best"; then best="$t"; fi
	done < <(git_tags "$1")
	printf '%s\n' "$best"
}
git_head() { git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1; exit}'; }
git_branch_commit() { git ls-remote --heads "$1" "refs/heads/$2" 2>/dev/null | awk '{print $1; exit}'; }

# install_git url [ref] [pin]
#   ref: empty (highest semver tag, else HEAD), HEAD, a tag, a branch, a full
#   40-hex commit, or a lock label (branch:NAME, commit:SHA12). pin: "commit:<sha>".
#   The lock label is: the tag, HEAD, branch:NAME or commit:SHA12.
install_git_one() { # url [ref] [pin]
	need git
	local url="$1" ref="$2" pin="$3" commit="" kind="" label="" name src zip dir file hash
	if [[ -z "$ref" && -z "$pin" ]]; then
		ref="$(git_highest_tag "$url")"; [[ -n "$ref" ]] || ref=HEAD
	fi
	case "$ref" in
		HEAD) kind=head; label=HEAD ;;
		branch:*) kind=branch; ref="${ref#branch:}"; label="branch:$ref" ;;
		commit:*) kind=commit; ref="${ref#commit:}"; label="commit:${ref:0:12}" ;;
		*) kind="" ;;
	esac
	if [[ -n "$pin" ]]; then
		commit="${pin#commit:}"
		[[ -n "$kind" ]] || { kind=tag; label="$ref"; }
	elif [[ "$kind" == head ]]; then
		commit="$(git_head "$url")"
		[[ -n "$commit" ]] || die "cannot resolve HEAD of $url (not a reachable git repository?)"
	elif [[ "$kind" == branch ]]; then
		commit="$(git_branch_commit "$url" "$ref")"
		[[ -n "$commit" ]] || die "branch '$ref' not found in $url"
	elif [[ "$kind" == commit ]]; then
		commit="$ref"
	else
		commit="$(git_tags "$url" | awk -v t="$ref" '$1==t{print $2; exit}')"
		if [[ -n "$commit" ]]; then kind=tag; label="$ref"
		elif commit="$(git_branch_commit "$url" "$ref")"; [[ -n "$commit" ]]; then kind=branch; label="branch:$ref"
		elif [[ "$ref" =~ ^[0-9a-fA-F]{40}$ ]]; then kind=commit; commit="$ref"; label="commit:${ref:0:12}"
		else die "'$ref' is not a tag, branch or full commit hash in $url"; fi
	fi
	[[ "$kind" == commit && ! "$commit" =~ ^[0-9a-fA-F]{40}$ ]] && die "a commit must be given as the full 40-character hash"

	tmproot
	src="$TMPROOT/src.$RANDOM$RANDOM"; mkdir -p "$src"
	if ! { git -C "$src" init -q && git -C "$src" remote add origin "$url" \
		&& git -C "$src" fetch -q --depth 1 origin "$commit" 2>/dev/null && git -C "$src" checkout -q FETCH_HEAD 2>/dev/null; }; then
		rm -rf "$src"; mkdir -p "$src"
		case "$kind" in
			tag|branch) git clone -q --depth 1 --branch "$ref" "$url" "$src" 2>/dev/null ;;
			head) git clone -q --depth 1 "$url" "$src" 2>/dev/null ;;
			commit) git clone -q "$url" "$src" 2>/dev/null && git -C "$src" checkout -q "$commit" 2>/dev/null ;;
		esac || die "git clone of $url failed"
		[[ "$(git -C "$src" rev-parse HEAD)" == "$commit" ]] || die "commit mismatch for $url@$label: expected $commit, got $(git -C "$src" rev-parse HEAD)"
	fi
	[[ -f "$src/manifest.json" ]] || die "$url has no manifest.json at its root (not a C3 library)"
	name="$(json_string_field provides < "$src/manifest.json")"
	[[ -n "$name" ]] || die "manifest.json of $url has no 'provides'"
	[[ -f "$src/.gitmodules" ]] && warn "$url uses submodules; they are not included in the library"
	check_collision "$name" git "$url"

	zip="$TMPROOT/$name.c3l.$RANDOM"
	# Archive the committed bytes the same way everywhere: stored (-0), UTC
	# timestamps, no line-ending or filter conversion (core.autocrlf, eol=).
	mkdir -p "$src/.git/info"; echo '* -text -filter -ident -working-tree-encoding' > "$src/.git/info/attributes"
	TZ=UTC git -C "$src" -c core.autocrlf=false -c core.eol=lf archive --format=zip -0 -o "$zip" HEAD || die "git archive failed"
	hash="commit:$commit"   # git commit ids are content-addressed; nothing else to hash

	find_project
	txn_begin "$name"
	dir="$TXN_DIR"; file="$dir/$name.c3l"
	mkdir -p "$dir"; rm -rf "$file"
	cp "$zip" "$file" || txn_fail "cannot write $file"
	in_deps "$name" || { deps_edit add "$name" || txn_fail "could not register $name in $PROJECT"; }
	local role="$INSTALL_ROLE"; [[ -n "$pin" ]] && role=keep
	read_reqs "$name" "$file"
	lock_put "$name" git "$url" "$label" "commit:$commit" "$hash" "$role" "$REQ_NAMES"
	info "installed $name $label (commit ${commit:0:12})"
}

#
# Operation journal: adding or updating one library together with everything it pulls
# in is ONE transaction. On any failure (die) the project file, the lockfile and the
# library files are restored.
#
OP_ON=0; OP_DIR=""; OP_LIBDIR=""; OP_NEW=(); OP_SAVED=()
op_begin() {
	(( OP_ON )) && return 0
	tmproot
	OP_DIR="$TMPROOT/op.$RANDOM$RANDOM"; mkdir -p "$OP_DIR/lib"
	cp -p "$PROJECT" "$OP_DIR/project"
	[[ -f "$LOCK" ]] && cp -p "$LOCK" "$OP_DIR/lock"
	OP_LIBDIR="$(lib_dir)" || exit 1; OP_NEW=(); OP_SAVED=(); OP_ON=1
	STACK=(); DEP_COUNT=0
}
op_backup() { # name: remember the library file before it is replaced
	local n="$1" x
	for x in ${OP_SAVED[@]+"${OP_SAVED[@]}"} ${OP_NEW[@]+"${OP_NEW[@]}"}; do [[ "$x" == "$n" ]] && return 0; done
	if [[ -e "$OP_LIBDIR/$n.c3l" ]]; then cp -a "$OP_LIBDIR/$n.c3l" "$OP_DIR/lib/$n.c3l"; OP_SAVED+=("$n"); else OP_NEW+=("$n"); fi
	return 0
}
op_commit() { OP_ON=0; }
op_rollback() {
	(( OP_ON )) || return 0
	OP_ON=0
	local n
	cp -p "$OP_DIR/project" "$PROJECT"
	if [[ -f "$OP_DIR/lock" ]]; then cp -p "$OP_DIR/lock" "$LOCK"; else rm -f "$LOCK"; fi
	for n in ${OP_NEW[@]+"${OP_NEW[@]}"} ${OP_SAVED[@]+"${OP_SAVED[@]}"}; do rm -rf "${OP_LIBDIR:?}/$n.c3l"; done
	for n in ${OP_SAVED[@]+"${OP_SAVED[@]}"}; do cp -a "$OP_DIR/lib/$n.c3l" "$OP_LIBDIR/$n.c3l"; done
	return 0
}

#
# Reading a library's own dependency declarations (manifest.json, JSON5 tolerant)
#
# json_flatten: JSON on stdin -> "path<TAB>value" per scalar, e.g.
#   vendor.c3l.requires[0].name<TAB>vk      dependencies[1]<TAB>box2d
# Understands // and /* */ comments, trailing commas, single quotes.
AWK_FLAT='
BEGIN { RS = "\001" }
function valpath(   d) {
	d = depth
	if (d == 0) return ""
	if (ct[d] == "a") return cp[d] "[" ci[d]++ "]"
	return (cp[d] == "" ? ck[d] : cp[d] "." ck[d])
}
function after_value() { if (depth > 0 && ct[depth] == "o") ek[depth] = 1 }
function emit(v) { print valpath() "\t" v; after_value() }
{
	s = $0; n = length(s); i = 1
	while (i <= n) {
		c = substr(s, i, 1)
		if (index(" \t\r\n,:", c)) { i++; continue }
		if (c == "/") {
			d2 = substr(s, i + 1, 1)
			if (d2 == "/") { while (i <= n && substr(s, i, 1) != "\n") i++; continue }
			if (d2 == "*") { i += 2; while (i <= n && substr(s, i, 2) != "*/") i++; i += 2; continue }
		}
		if (c == "{" || c == "[") {
			p = valpath(); depth++
			ct[depth] = (c == "{" ? "o" : "a"); cp[depth] = p; ci[depth] = 0; ek[depth] = (c == "{"); ck[depth] = ""
			i++; continue
		}
		if (c == "}" || c == "]") { depth--; after_value(); i++; continue }
		if (c == "\"" || c == "\047") {
			q = c; i++; str = ""
			while (i <= n) {
				c = substr(s, i, 1)
				if (c == "\\") { e = substr(s, i + 1, 1); str = str (e == "n" ? "\n" : (e == "t" ? "\t" : e)); i += 2; continue }
				if (c == q) break
				str = str c; i++
			}
			i++
			if (depth > 0 && ct[depth] == "o" && ek[depth]) { ck[depth] = str; ek[depth] = 0 } else emit(str)
			continue
		}
		lit = ""
		while (i <= n) { c = substr(s, i, 1); if (index(" \t\r\n,:]}[{", c)) break; lit = lit c; i++ }
		if (depth > 0 && ct[depth] == "o" && ek[depth]) { ck[depth] = lit; ek[depth] = 0 } else emit(lit)
	}
}
'
json_flatten() { awk "$AWK_FLAT"; }

# manifest_reqs: flattened manifest on stdin -> "name<TAB>source<TAB>version" per requirement
# ("-" = unknown). Precedence per name: vendor.c3l.requires, vendor.c3po.sources (read-only
# c3po compatibility), then c3c's own "dependencies" names (no source, no version).
AWK_REQS='
BEGIN { FS = "\t" }
function guess(s,   t) { t = s; sub(/\/+$/, "", t); sub(/.*[\/:]/, "", t); sub(/\.git$/, "", t); sub(/\.c3l$/, "", t); return t }
function idx(p,   t) { t = substr(p, index(p, "[") + 1); sub(/\].*/, "", t); return t }
function key(p,   t) { t = p; sub(/.*\./, "", t); return t }
$1 ~ /^vendor\.c3l\.requires\[[0-9]+\]\.(name|source|version)$/ { i = idx($1); a[i, key($1)] = $2; if (!(i in sa)) { sa[i] = 1; oa[++na] = i }; next }
$1 ~ /^vendor\.c3po\.sources\[[0-9]+\]\.(name|source)$/ { i = idx($1); b[i, key($1)] = $2; if (!(i in sb)) { sb[i] = 1; ob[++nb] = i }; next }
$1 ~ /^(targets\.[^.]*\.)?dependencies\[[0-9]+\]$/ { if (!($2 in sp)) { sp[$2] = 1; op[++np] = $2 }; next }
END {
	for (j = 1; j <= na; j++) {
		i = oa[j]; nm = a[i, "name"]; src = a[i, "source"]; ver = a[i, "version"]
		if (nm == "") nm = guess(src)
		if (nm == "" || (nm in done)) continue
		done[nm] = 1; print nm "\t" (src == "" ? "-" : src) "\t" (ver == "" ? "-" : ver)
	}
	for (j = 1; j <= nb; j++) {
		i = ob[j]; nm = b[i, "name"]; src = b[i, "source"]
		if (nm == "") nm = guess(src)
		if (nm == "" || (nm in done)) continue
		done[nm] = 1; print nm "\t" (src == "" ? "-" : src) "\t-"
	}
	for (j = 1; j <= np; j++) if (!(op[j] in done)) { done[op[j]] = 1; print op[j] "\t-\t-" }
}
'
manifest_reqs() { awk "$AWK_REQS"; }

# read_reqs <self name> <library file or directory>: sets LAST_NAME, LAST_REQS (full
# records) and REQ_NAMES (comma list for the lockfile, "-" if none).
read_reqs() {
	local self="$1" f="$2"
	if [[ -d "$f" ]]; then LAST_REQS="$(json_flatten < "$f/manifest.json" 2>/dev/null | manifest_reqs)"
	else LAST_REQS="$(zip_read "$f" manifest.json | json_flatten | manifest_reqs)"; fi
	REQ_NAMES="$(awk -F'\t' -v s="$self" '$1 != "" && $1 != s { printf "%s%s", (n++ ? "," : ""), $1 }' <<< "$LAST_REQS")"
	[[ -n "$REQ_NAMES" ]] || REQ_NAMES="-"
	LAST_NAME="$self"
}

#
# The dependency graph as recorded in the lockfile (column 8 = what a library requires)
#
lock_reaches() { # from to: can <from> reach <to> through requirements?
	lock_entries | awk -F'\t' -v s="$1" -v t="$2" '
		{ adj[$1] = $8 }
		END {
			q[1] = s; seen[s] = 1; tail = 1
			for (h = 1; h <= tail; h++) {
				x = q[h]; if (x == t) found = 1
				m = split(adj[x], a, ",")
				for (i = 1; i <= m; i++) if (a[i] != "-" && !(a[i] in seen)) { seen[a[i]] = 1; q[++tail] = a[i] }
			}
			exit !found
		}'
}
lock_dependents() { # name -> libraries that require it
	lock_entries | awk -F'\t' -v n="$1" '$1 != n { m = split($8, a, ","); for (i = 1; i <= m; i++) if (a[i] == n) { print $1; break } }'
}
lock_orphans() { # dependency libraries that no direct library reaches
	lock_entries | awk -F'\t' '
		{ role[$1] = $7; adj[$1] = $8; names[++cnt] = $1 }
		END {
			for (i = 1; i <= cnt; i++) if (role[names[i]] == "direct") { q[++tail] = names[i]; seen[names[i]] = 1 }
			for (h = 1; h <= tail; h++) {
				m = split(adj[q[h]], a, ",")
				for (j = 1; j <= m; j++) if (a[j] != "-" && (a[j] in role) && !(a[j] in seen)) { seen[a[j]] = 1; q[++tail] = a[j] }
			}
			for (i = 1; i <= cnt; i++) if (!(names[i] in seen)) print names[i]
		}'
}

#
# Trust: a manifest from the internet can name any git URL
#
TRUSTED_HOSTS=" github.com codeberg.org "
url_host() {
	local u="$1"
	case "$u" in
		file://*|/*|./*|../*) echo file ;;
		git@*) u="${u#git@}"; echo "${u%%:*}" ;;
		*://*) u="${u#*://}"; u="${u%%/*}"; u="${u##*@}"; echo "${u%%:*}" ;;
		*) echo "$u" ;;
	esac
}
trust_host() { # url: 0 if the host is allowed (asks when interactive), else dies
	local h a t; h="$(url_host "$1")"
	[[ -n "$h" ]] || die "refusing to fetch $1: no host in the URL"
	for t in $TRUSTED_HOSTS ${C3L_ALLOWED_HOSTS//,/ }; do [[ "$t" == "$h" ]] && return 0; done
	if [[ -t 0 && -t 2 ]]; then
		read -r -p "A dependency wants to fetch from '$h' ($1). Allow? [y/N] " a
		if [[ "$a" == [yY]* ]]; then TRUSTED_HOSTS+=" $h "; return 0; fi
	fi
	die "refusing to fetch $1: host '$h' is not trusted. Allow it with --allow-host $h (or \$C3L_ALLOWED_HOSTS)"
}

#
# Following dependencies. Each library is installed once (the lockfile is the memory),
# a cycle is a warning (an error with --strict), never a loop.
#
stack_has() { local x; for x in ${STACK[@]+"${STACK[@]}"}; do [[ "$x" == "$1" ]] && return 0; done; return 1; }
stack_path() { local x out=""; for x in ${STACK[@]+"${STACK[@]}"}; do out+="$x -> "; done; printf '%s%s' "$out" "$1"; }
cycle_warn() {
	(( STRICT )) && die "dependency cycle: $1 (--strict)"
	warn "dependency cycle: $1 (each library is installed once)"
}
git_ref_of() { local v="$1"; v="${v#>=}"; v="${v#^}"; v="${v#\~}"; printf '%s' "$v"; }
norm_ver() { local v="$1"; v="${v#>=}"; v="${v#^}"; v="${v#\~}"; v="${v#v}"; printf '%s' "$v"; }
same_source() { local a="${1%/}" b="${2%/}"; a="${a%.git}"; b="${b%.git}"; [[ "$a" == "$b" ]]; }

follow_deps() { # name requirement-records
	local name="$1" reqs="$2" rname rsrc rver
	[[ -n "$reqs" ]] || return 0
	STACK+=("$name")
	while IFS=$'\t' read -r -u 3 rname rsrc rver; do
		[[ -n "$rname" ]] || continue
		[[ "$rsrc" == - ]] && rsrc=""; [[ "$rver" == - ]] && rver=""
		resolve_req "$name" "$rname" "$rsrc" "$rver"
	done 3<<< "$reqs"
	STACK=("${STACK[@]:0:${#STACK[@]}-1}")
}

satisfy_existing() { # parent name source version lock-record
	local parent="$1" name="$2" src="$3" ver rec="$5" ekind esrc ever em rm saved nm rq
	ver="$(norm_ver "$4")"
	IFS=$'\t' read -r _ ekind esrc ever _ <<< "$rec"
	if [[ -n "$src" ]] && ! same_source "$src" "$esrc"; then
		die "'$name' is installed from $ekind:$esrc but $parent requires it from $src. Library names are global in a project; remove one of them"
	fi
	[[ -n "$ver" ]] || return 0
	if [[ "$ekind" == registry ]]; then
		valid_semver "$ver" && valid_semver "$ever" || return 0
		em="${ever#v}"; em="${em%%.*}"; rm="${ver#v}"; rm="${rm%%.*}"
		[[ "$em" == "$rm" ]] || die "version conflict: $parent needs $name $ver (major $rm) but $ever (major $em) is installed"
		if [[ "$(semver_cmp "$ever" "$ver")" == -1 ]]; then
			info "  $name $ever -> $ver (required by $parent)"
			saved="$INSTALL_ROLE"; INSTALL_ROLE=keep
			install_registry_one "$esrc" "$ver" ""
			INSTALL_ROLE="$saved"
			nm="$LAST_NAME"; rq="$LAST_REQS"; follow_deps "$nm" "$rq"
		fi
	elif [[ "$ever" != "$ver" ]]; then
		warn "$parent wants $name@$ver, keeping the installed $ever (the first requirement wins)"
	fi
	return 0
}

resolve_req() { # parent name source version
	local parent="$1" name="$2" src="$3" ver="$4" rec saved nm rq
	if [[ "$name" == "$parent" ]]; then
		(( STRICT )) && die "$parent lists itself as a dependency (--strict)"
		warn "$parent lists itself as a dependency; ignored"; return 0
	fi
	if stack_has "$name"; then cycle_warn "$(stack_path "$name")"; return 0; fi
	rec="$(lock_get "$name")"
	if [[ -n "$rec" ]]; then
		if lock_reaches "$name" "$parent"; then cycle_warn "$(stack_path "$name") -> ... -> $parent (through installed libraries)"; fi
		satisfy_existing "$parent" "$name" "$src" "$ver" "$rec"
		return 0
	fi
	if [[ -z "$src" ]]; then
		if in_deps "$name" || [[ -e "$(lib_dir)/$name.c3l" ]]; then return 0; fi
		warn "$parent needs '$name' but declares no source for it; install it with: $PROGRAM add <ns/name|git-url>"
		return 0
	fi
	DEP_COUNT=$((DEP_COUNT+1))
	(( DEP_COUNT <= DEP_MAX )) || die "more than $DEP_MAX transitive libraries; refusing (see C3L_MAX_DEPS)"
	saved="$INSTALL_ROLE"; INSTALL_ROLE=dep
	if is_git_url "$src"; then trust_host "$src"; install_git_one "$src" "$(git_ref_of "$ver")" ""
	elif is_registry_id "$src"; then install_registry_one "$src" "$(norm_ver "$ver")" ""
	else die "$parent requires '$name' from '$src', which is neither <namespace>/<name> nor a git URL"; fi
	INSTALL_ROLE="$saved"
	info "  $LAST_NAME installed for $parent"
	nm="$LAST_NAME"; rq="$LAST_REQS"
	follow_deps "$nm" "$rq"
}

# Top level: install one library and, unless this is a restore from the lock (pin given),
# follow the dependencies it declares. One transaction for all of it.
install_registry() { # id version pin
	install_registry_one "$@"
	local nm="$LAST_NAME" rq="$LAST_REQS"
	[[ -n "$3" ]] || follow_deps "$nm" "$rq"
	op_commit
}
install_git() { # url ref pin
	install_git_one "$@"
	local nm="$LAST_NAME" rq="$LAST_REQS"
	[[ -n "$3" ]] || follow_deps "$nm" "$rq"
	op_commit
}

#
# Status helpers
#
# For git libraries the file is an archive of the locked commit; `git archive`
# stores that commit id in the zip comment, so compare it with the pin.
lib_status() { # name hash dir kind pin
	local f="$3/$1.c3l"
	if [[ -d "$f" ]]; then echo unpacked
	elif [[ ! -f "$f" ]]; then echo missing
	elif [[ "$4" == git ]]; then
		if [[ "commit:$(unzip -z "$f" 2>/dev/null | sed -n '2p' | tr -d '\r ')" == "$5" ]]; then echo ok; else echo modified; fi
	elif [[ "sha256:$(sha256_file "$f")" == "$2" ]]; then echo ok
	else echo modified; fi
}

latest_for() { # kind source version pin -> newest version label (empty if unknown)
	case "$1" in
		registry) registry_info "$2" 2>/dev/null | info_latest ;;
		git) local t h
			case "$3" in
				HEAD) h="$(git_head "$2")" ;;
				branch:*) h="$(git_branch_commit "$2" "${3#branch:}")" ;;
				commit:*) return 0 ;;
				*) t="$(git_highest_tag "$2")"; [[ -n "$t" ]] && echo "$t"; return 0 ;;
			esac
			if [[ -n "$h" && "commit:$h" != "$4" ]]; then echo "HEAD@${h:0:12}"; fi ;;
	esac
	return 0
}

#
# Registry backends
#
# A registry is a set of functions be_<type>_<op>. Types:
#   static  read-only c3c-fetch registry (any HTTP server or directory); the default
#   c3pkg   www.c3pkg.eu API: also publishing, version list, per-version compatibility data
# The type is --registry-type > $C3L_REGISTRY_TYPE > detected by probing the registry.
# Ops: versions <name>        (published versions, one per line; rc 2 = unknown package, rc 1 = cannot tell)
#      index <name> <ver>     (JSON with c3_version, targets, sha256_file; rc 1 = none)
#      publish <name> <ver> <file> <c3_version>
# A new registry type only needs these functions.
#
BE_TYPE=""; BE_GUESSED=0

be_detect() {
	local t="${REGISTRY_TYPE_OPT:-$C3L_REGISTRY_TYPE}" r
	r="$(registry)"
	if [[ -z "$t" && "$r" == http* ]]; then
		local probe; probe="$(curl -fsS -m 10 --retry 1 "$r/api/v1/packages?per_page=1" 2>/dev/null)"
		[[ "$probe" == \{* || "$probe" == \[* ]] && t=c3pkg
		BE_GUESSED=1
	fi
	BE_TYPE="${t:-static}"
	declare -F "be_${BE_TYPE}_versions" >/dev/null || die "unknown registry type '$BE_TYPE' (known: static, c3pkg)"
}
be() { local op="$1"; shift; [[ -n "$BE_TYPE" ]] || be_detect; "be_${BE_TYPE}_$op" "$@"; }

be_static_can_publish() { return 1; }
be_c3pkg_can_publish()  { return 0; }
be_static_versions() { return 1; }
be_static_index()    { return 1; }
be_static_publish()  {
	die "registry $(registry) is read-only (type 'static'); publishing needs a registry with an upload API such as c3pkg$( ((BE_GUESSED)) && echo ". The type was detected automatically; if this is a c3pkg registry, retry or pass --registry-type c3pkg")"
}

be_c3pkg_versions() { # name
	need curl; tmproot
	local body="$TMPROOT/versions.json" code
	code="$(curl -sS -m 30 -o "$body" -w '%{http_code}' "$(registry)/api/v1/packages/$1/versions" 2>/dev/null)" || return 1
	case "$code" in
		200) grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$body" | sed 's/.*:[[:space:]]*"\(.*\)"/\1/'; return 0 ;;
		404) return 2 ;;
		*) return 1 ;;
	esac
}
be_c3pkg_index() { # id|name version
	need curl
	curl -fsS -m 30 "$(registry)/index/${1##*/}/$2.json" 2>/dev/null
}

# Authorization header in a 0600 file, so the token never shows up in argv or ps.
auth_header_file() {
	local t=""
	if [[ -n "$TOKEN_FILE" ]]; then
		[[ -r "$TOKEN_FILE" ]] || die "cannot read token file $TOKEN_FILE"
		t="$(head -n 1 "$TOKEN_FILE")"
	elif [[ -n "$C3L_TOKEN" ]]; then t="$C3L_TOKEN"
	elif [[ -n "$C3PKG_TOKEN" ]]; then t="$C3PKG_TOKEN"
	fi
	t="${t//[[:space:]]/}"
	[[ -n "$t" ]] || die "no API token. Create one in the registry settings and pass it with --token-file FILE, \$C3L_TOKEN or \$C3PKG_TOKEN"
	tmproot
	local f="$TMPROOT/auth.hdr"
	( umask 077; printf 'Authorization: Bearer %s\n' "$t" > "$f" )
	printf '%s\n' "$f"
}

be_c3pkg_publish() { # name version file c3_version
	need curl; tmproot
	local name="$1" ver="$2" file="$3" c3v="$4" hdr body="$TMPROOT/publish.json" heads="$TMPROOT/publish.hdr" code msg wait
	hdr="$(auth_header_file)" || exit 1   # its die ran in the subshell
	local -a a=(-sS -m 600 -X PUT -H "@$hdr" -D "$heads" -o "$body" -w '%{http_code}'
		-F "file=@$file;type=application/zip" --form-string "c3_version=$c3v")
	[[ -n "$DESC_OPT" ]] && a+=(--form-string "description=$DESC_OPT")
	[[ -n "$LICENSE_OPT" ]] && a+=(--form-string "license=$LICENSE_OPT")
	[[ -n "$TAGS_OPT" ]] && a+=(--form-string "tags=$TAGS_OPT")
	[[ -n "$DOCS_OPT" ]] && a+=(--form-string "docs_url=$DOCS_OPT")
	[[ -n "$GIT_OPT" ]] && a+=(--form-string "git_url=$GIT_OPT")
	code="$(curl "${a[@]}" "$(registry)/api/v1/packages/$name/versions/$ver")" || die "upload failed: cannot reach $(registry)"
	if [[ "$code" == 201 ]]; then return 0; fi
	msg="$(json_string_field error < "$body")"; [[ -n "$msg" ]] || msg="$(head -c 300 "$body")"
	case "$code" in
		401|403) die "registry rejected the token (HTTP $code): ${msg:-not authorized}" ;;
		429) wait="$(awk -F': *' 'tolower($1)=="retry-after"{gsub(/\r/,"",$2); print $2}' "$heads")"
			die "rate limited by the registry; retry in ${wait:-a few} seconds" ;;
		*) die "registry refused $name@$ver (HTTP $code): $msg" ;;
	esac
}

#
# Compatibility between a library version and the local toolchain
#
local_c3_version() {
	local out; out="$("$C3C" --version 2>&1)"
	sed -n 's/^C3 Compiler Version:[[:space:]]*\([0-9][0-9.]*\).*/\1/p' <<< "$out" | head -n 1
}

host_target() {
	local os arch
	case "$(uname -s)" in Linux) os=linux ;; Darwin) os=macos ;; MINGW*|MSYS*|CYGWIN*) os=windows ;; FreeBSD) os=freebsd ;; *) return 0 ;; esac
	case "$(uname -m)" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=aarch64 ;; *) return 0 ;; esac
	printf '%s-%s\n' "$os" "$arch"
}

COMPAT_WARNED=0
# compat_check <id> <version>: warn when the library was built for another C3 release
# or does not list this host. Needs a registry that publishes this data; silent otherwise.
compat_check() {
	COMPAT_WARNED=0
	local json c3v mine host targets
	be_type_name >/dev/null   # detect once in this shell
	json="$(be index "$1" "$2")" || return 0
	json="$(printf '%s' "$json" | tr -d '\n\r')"
	[[ -n "$json" ]] || return 0
	c3v="$(json_string_field c3_version <<< "$json")"
	mine="$(local_c3_version)"
	if [[ -n "$c3v" && -n "$mine" && "${c3v%.*}" != "${mine%.*}" ]]; then
		warn "$1@$2 was published for C3 $c3v, you have c3c $mine (C3 is pre-1.0: minor releases can break libraries)"
		COMPAT_WARNED=1
	fi
	host="$(host_target)"
	targets="$(grep -o '"targets"[[:space:]]*:[[:space:]]*\[[^]]*\]' <<< "$json")"
	if [[ -n "$host" && "$targets" == *'"'* && "$targets" != *"\"$host\""* ]]; then
		warn "$1@$2 does not list this platform ($host); it supports: $(grep -o '"[a-z0-9-]*"' <<< "${targets#*:}" | tr -d '"' | paste -sd, -)"
		COMPAT_WARNED=1
	fi
	return 0
}

#
# Packaging and publishing
#
strict_semver() { [[ "$1" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]]; }

PUB_DIR=""; PUB_NAME=""; PUB_VERSION=""; PUB_VSRC=""; PUB_C3V=""; PUB_NEW=0; PUB_STAGE=""; ERRS=0
perr() { printf '%s[ERROR]%s %s\n' "$C_R" "$C_0" "$*" >&2; ERRS=$((ERRS+1)); }

# Version of a library, in this order: --version, a semver tag on HEAD, "version" in manifest.json.
json_top_version() { # file -> its top-level "version" string (empty if none or no file)
	[[ -f "$1" ]] || return 0
	json_flatten < "$1" | awk -F'\t' '$1 == "version" { print $2; exit }'
}

# Order: --version, a semver tag on HEAD, "version" in manifest.json, "version" in project.json.
# A source that says something else than the chosen version only gets a warning.
pub_resolve_version() { # dir
	local dir="$1" mver pver pfile tag t best="" v
	mver="$(json_top_version "$dir/manifest.json")"
	pfile="$dir/project.json"; [[ -f "$pfile" ]] || pfile="$dir/project.json5"
	pver="$(json_top_version "$pfile")"
	if command -v git >/dev/null 2>&1 && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		while IFS= read -r t; do
			v="${t#v}"; strict_semver "$v" || continue
			if [[ -z "$best" || "$(semver_cmp "$v" "$best")" == 1 ]]; then best="$v"; tag="$t"; fi
		done < <(git -C "$dir" tag --points-at HEAD)
	fi
	if [[ -n "$PKG_VERSION" ]]; then
		PUB_VERSION="${PKG_VERSION#v}"; PUB_VSRC="--version"
		[[ -n "$best" && "$best" != "$PUB_VERSION" ]] && warn "tag $tag on HEAD says $best, but --version says $PUB_VERSION; using $PUB_VERSION"
	elif [[ -n "$best" ]]; then
		PUB_VERSION="$best"; PUB_VSRC="git tag $tag"
	elif [[ -n "$mver" ]]; then
		PUB_VERSION="$mver"; PUB_VSRC="manifest.json"
	elif [[ -n "$pver" ]]; then
		PUB_VERSION="$pver"; PUB_VSRC="${pfile##*/}"
	else
		return 1
	fi
	if [[ -n "$mver" && "$mver" != "$PUB_VERSION" ]]; then
		warn "manifest.json says version $mver, publishing $PUB_VERSION (from $PUB_VSRC); the archive's manifest gets $PUB_VERSION"
	fi
	if [[ -n "$pver" && "$pver" != "$PUB_VERSION" ]]; then
		warn "${pfile##*/} says version $pver, publishing $PUB_VERSION (from $PUB_VSRC)"
	fi
	return 0
}

set_manifest_version() { # file version
	if grep -Eq '^[[:space:]]*"version"[[:space:]]*:' "$1"; then
		awk -v v="$2" '!d && /^[[:space:]]*"version"[[:space:]]*:/ { sub(/"version"[[:space:]]*:[[:space:]]*"[^"]*"/, "\"version\" : \"" v "\""); d=1 } { print }' "$1" > "$1.new" && mv "$1.new" "$1"
	else
		awk -v v="$2" '!d && /\{/ { sub(/\{/, "{\n  \"version\" : \"" v "\","); d=1 } { print }' "$1" > "$1.new" && mv "$1.new" "$1"
	fi
}

# Files that belong in the package: tracked + untracked-not-ignored in a git repo, else everything.
pub_files() { # dir
	local f
	{
		if command -v git >/dev/null 2>&1 && git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
			( cd "$1" && git -c core.quotepath=off ls-files -co --exclude-standard )
		else
			( cd "$1" && find . -type f -not -path './.git/*' | sed 's|^\./||' )
		fi
	} | pub_exclude | LC_ALL=C sort -u | while IFS= read -r f; do
		[[ -f "$1/$f" ]] && printf '%s\n' "$f"
	done
}

# untracked, not ignored, and part of the package (what 'git status' would flag, minus what is never packed)
pub_untracked() { # dir
	( cd "$1" && git -c core.quotepath=off ls-files -o --exclude-standard ) | pub_exclude
}
pub_exclude() { grep -v -e '^c3l\.lock$' -e '^[^/]*\.c3l$' -e '^obj/' -e '^build/'; }

# vendor.c3l.requires from the library's own c3l.lock: its direct dependencies, with the
# locked version as the minimum. Empty output if there is no lock or nothing direct.
pub_requires_json() { # dir
	local lock="$1/c3l.lock" out="" name kind source version role
	[[ -f "$lock" ]] || return 0
	while IFS=$'\t' read -r name kind source version _ _ role _; do
		[[ "$role" == direct ]] || continue
		[[ "$kind" == git && "$version" == HEAD ]] && version=""
		out+="${out:+, }{ \"name\": \"$name\", \"source\": \"$source\"${version:+, \"version\": \"$version\"} }"
	done < <(LOCK="$lock" lock_entries)
	[[ -n "$out" ]] && printf '[ %s ]' "$out"
	return 0
}

# Add "vendor": {"c3l": {"requires": ...}} right after the opening brace (commas stay valid).
# Does nothing if the author already wrote requires or has another vendor block.
set_manifest_requires() { # file json-array
	local flat; flat="$(json_flatten < "$1")"
	grep -q '^vendor\.' <<< "$flat" && return 0
	awk -v r="$2" '!d && /\{/ { sub(/\{/, "{\n  \"vendor\" : { \"c3l\" : { \"requires\" : " r " } },"); d=1 } { print }' "$1" > "$1.new" && mv "$1.new" "$1"
}

pub_stage() { # copies the package to $TMPROOT/stage/<name>.c3l with the final manifest
	tmproot
	local base="$TMPROOT/stage" files="$TMPROOT/files.lst"
	rm -rf "$base"; mkdir -p "$base/$PUB_NAME.c3l"
	pub_files "$PUB_DIR" > "$files"
	[[ -s "$files" ]] || die "no files to pack in $PUB_DIR"
	( cd "$PUB_DIR" && tar -cf - -T "$files" ) | tar -xf - -C "$base/$PUB_NAME.c3l" || die "staging $PUB_DIR failed"
	set_manifest_version "$base/$PUB_NAME.c3l/manifest.json" "$PUB_VERSION"
	local reqs; reqs="$(pub_requires_json "$PUB_DIR")"
	[[ -z "$reqs" ]] || set_manifest_requires "$base/$PUB_NAME.c3l/manifest.json" "$reqs"
	find "$base/$PUB_NAME.c3l" -type f ! -perm -u+x -exec chmod 644 {} + 2>/dev/null
	find "$base/$PUB_NAME.c3l" -type f -perm -u+x -exec chmod 755 {} + 2>/dev/null
	PUB_STAGE="$base/$PUB_NAME.c3l"
}

# Deterministic zip: sorted names, fixed timestamps, so the same tree gives the same bytes.
# Uses zip(1); python3 is only a fallback when zip is missing.
pub_zip() { # stagedir outfile
	local out; out="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
	rm -f "$out"
	if command -v zip >/dev/null 2>&1; then
		( cd "$1" && find . -type f -exec touch -t 198001010000 {} + &&
			find . -type f | sed 's|^\./||' | LC_ALL=C sort | zip -X -q "$out" -@ ) || die "creating $out failed"
	elif command -v python3 >/dev/null 2>&1; then
		python3 -I - "$1" "$out" <<'PY' || die "creating $out failed"
import os, sys, zipfile
src, out = sys.argv[1:3]
names = sorted(os.path.relpath(os.path.join(r, f), src) for r, _, fs in os.walk(src) for f in fs)
with zipfile.ZipFile(out, "w") as z:
    for n in names:
        p = os.path.join(src, n)
        zi = zipfile.ZipInfo(n.replace(os.sep, "/"), (1980, 1, 1, 0, 0, 0))
        zi.compress_type = zipfile.ZIP_DEFLATED
        zi.external_attr = (0o755 if os.access(p, os.X_OK) else 0o644) << 16
        with open(p, "rb") as fh:
            z.writestr(zi, fh.read())
PY
	else
		die "zip is required to create the package (python3 also works)"
	fi
}

# pub_check <dir>: everything that can be verified before upload. Sets PUB_*, counts ERRS.
pub_check() {
	local dir="$1" vs v dirty
	ERRS=0; PUB_NEW=0
	[[ -d "$dir" ]] || { perr "$dir is not a directory"; return 1; }
	if [[ ! -f "$dir/manifest.json" ]]; then
		perr "no manifest.json in $dir; publish a library directory (create one with 'c3c init-lib <name>')"
		return 1
	fi
	PUB_DIR="$dir"
	PUB_NAME="$(json_string_field provides < "$dir/manifest.json")"
	if [[ -z "$PUB_NAME" ]]; then perr "manifest.json has no \"provides\" (the package name)"; return 1; fi
	[[ "$PUB_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || perr "invalid package name '$PUB_NAME' (letters, digits, '.', '_', '-')"

	if ! pub_resolve_version "$dir"; then
		perr "no version: tag the commit (git tag v1.2.3), pass --version 1.2.3, or set \"version\" in manifest.json (or project.json)"
		return 1
	fi
	if strict_semver "$PUB_VERSION"; then :; else
		perr "'$PUB_VERSION' (from $PUB_VSRC) is not a valid semantic version; the registry wants MAJOR.MINOR.PATCH or MAJOR.MINOR.PATCH-prerelease, e.g. 1.2.3 or 1.2.3-rc.1"
		return 1
	fi
	PUB_C3V="${C3_VERSION_OPT:-$(local_c3_version)}"
	[[ -n "$PUB_C3V" ]] || perr "cannot determine the C3 version; pass --c3-version"

	if [[ -z "$(find "$dir" -path "$dir/.git" -prune -o \( -name '*.c3' -o -name '*.c3i' \) -print -quit)" ]]; then
		warn "$dir contains no .c3/.c3i sources"
	fi
	[[ -f "$dir/README.md" ]] || warn "no README.md in $dir (the registry shows it as the package page)"

	# dependencies: consumers get them from vendor.c3l.requires in the published manifest
	local flat reqs dn ds
	flat="$(json_flatten < "$dir/manifest.json")"
	reqs="$(pub_requires_json "$dir")"
	if [[ -n "$reqs" ]] && grep -q '^vendor\.' <<< "$flat" && ! grep -q '^vendor\.c3l\.requires' <<< "$flat"; then
		warn "manifest.json already has a \"vendor\" block, so c3l cannot add vendor.c3l.requires; add it by hand: \"requires\": $reqs"
	fi
	while IFS=$'\t' read -r dn ds _; do
		[[ -n "$dn" ]] || continue
		if [[ "$dn" == "$PUB_NAME" ]]; then warn "$PUB_NAME lists itself as a dependency"; continue; fi
		[[ "$ds" == - ]] || continue
		grep -q "\"name\": \"$dn\"" <<< "$reqs" || warn "'$dn' is in the manifest's dependencies but nothing says where to get it; run 'c3l add' for it in this library so consumers can install it automatically"
	done < <(manifest_reqs <<< "$flat")

	if command -v git >/dev/null 2>&1 && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		dirty="$(git -C "$dir" status --porcelain --untracked-files=no -- . | head -n 1)"
		[[ -n "$dirty" ]] || dirty="$(pub_untracked "$dir" | head -n 1)"
		if [[ -n "$dirty" ]]; then
			if (( ALLOW_DIRTY )); then warn "working tree is not clean; the package will not match the commit"
			else perr "working tree is not clean (commit or stash, or pass --allow-dirty), so the package would not match a commit"; fi
		fi
	fi

	if (( ! NO_BUILD )); then
		if command -v "$C3C" >/dev/null 2>&1; then
			pub_stage; tmproot
			mkdir -p "$TMPROOT/buildcwd"
			if v="$(cd "$TMPROOT/buildcwd" && "$C3C" --libdir "$TMPROOT/stage" compile-only --lib "$PUB_NAME" --no-obj 2>&1)"; then
				info "library compiles with c3c $(local_c3_version)"
			else
				perr "the library does not compile:"; printf '%s\n' "$v" | tail -n 15 >&2
			fi
		else
			warn "c3c not found, skipping the compile check"
		fi
	fi

	if (( ! OFFLINE )); then
		be_type_name >/dev/null   # detect in this shell, not in the $(...) below
		local rc; vs="$(be versions "$PUB_NAME")"; rc=$?
		case $rc in
			0) if grep -qxF -- "$PUB_VERSION" <<< "$vs"; then
					perr "$PUB_NAME $PUB_VERSION is already published; versions are immutable, bump the version"
				else
					while IFS= read -r v; do
						[[ -n "$v" ]] || continue
						if [[ "$(semver_cmp "$PUB_VERSION" "$v")" == -1 ]]; then
							warn "$PUB_VERSION is older than the published $v"; break
						fi
					done <<< "$vs"
				fi ;;
			2) PUB_NEW=1
				[[ -n "$DESC_OPT" ]] || perr "$PUB_NAME is new on this registry: --description is required for the first publish" ;;
			*) [[ "$(be_type_name)" == static ]] || warn "could not query $(registry) for existing versions" ;;
		esac
	fi
	(( ERRS == 0 )) && info "$PUB_NAME $PUB_VERSION (from $PUB_VSRC, C3 $PUB_C3V) passes all checks"
	return 0
}
be_type_name() { [[ -n "$BE_TYPE" ]] || be_detect; printf '%s\n' "$BE_TYPE"; }

#
# Commands
#
cmd_version() { echo "c3l $VERSION"; }

cmd_usage() {
	cat <<-_EOF
	c3l $VERSION - reproducible dependencies for C3 projects (wrapper around 'c3c fetch')

	Usage: $PROGRAM [--registry URL] <command> [args]

	  init [name]               create a lockfile (and a project with 'c3c init name')
	  add <ns/name[@ver]>       install from the registry, verify, lock       (alias: fetch, f)
	  add <git-url>[@ref] [ref] install from git; ref = tag, branch, HEAD or commit
	  remove <name>             remove library, project entry and lock line   (alias: rm)
	  list                      show locked libraries and their state         (alias: ls)
	  verify                    check installed files against c3l.lock (exit 1 on problems)
	  outdated                  show libraries with newer versions
	  update [--dry-run] [name[@ref]...]  update to newest, or to name@ref (alias: u)
	  sync [--frozen]           restore exactly what c3l.lock says            (alias: pull, p)
	  search <text|tag:x>       search the registry
	  info <ns/name>            show registry record (c3c fetch-info)
	  migrate                   convert .c3l.deps (c3l 0.x) or project.lock.json (c3po) to c3l.lock
	  prune                     remove dependency libraries nothing needs any more
	  why <name>                show which libraries require <name>
	  list --tree               the dependency graph
	  check [dir]               verify a library is ready to publish (no upload)
	  pack [dir] [--output F]   build the deterministic <name>-<version>.c3l
	  publish [dir]             check, pack and upload to the registry (token: --token-file, \$C3L_TOKEN)
	  help | version

	Registry: --registry URL > \$C3L_REGISTRY > '@registry' in c3l.lock > $DEFAULT_REGISTRY
	See c3l(1).
	_EOF
}

cmd_init() {
	if [[ -n "$1" && ! -f project.json && ! -f project.json5 ]]; then
		"$C3C" init "$1" || die "c3c init failed"
		cd "$1" || die "cannot enter $1"
	fi
	find_project
	if [[ -f "$LOCK" ]]; then info "$LOCK already exists"; return 0; fi
	: | lock_write "$(registry)"
	info "created $LOCK (registry $(registry))"
	info "commit $LOCK; restore libraries on a fresh checkout with 'c3l sync'"
}

cmd_add() {
	(( $# >= 1 )) || die "Usage: $PROGRAM add <ns/name[@version]> | <git-url>[@tag|branch|HEAD|commit]"
	find_project
	local arg="$1" url ref="" last
	url="$arg"; last="${arg##*/}"
	if [[ "$arg" == */* && "$last" == *@* ]]; then ref="${last#*@}"; url="${arg%@"$ref"}"; fi
	if is_git_url "$url"; then
		if [[ -n "$ref" && -n "$2" ]]; then die "give the version either as <url>@<ref> or as a separate argument, not both"; fi
		TRUSTED_HOSTS+=" $(url_host "$url") "
		install_git "$url" "${ref:-$2}" ""
	elif is_registry_id "${arg%%@*}"; then
		if [[ "$arg" == *@* ]]; then install_registry "${arg%%@*}" "${arg#*@}" ""
		else install_registry "$arg" "" ""; fi
	else
		die "'$arg' is neither <namespace>/<name>[@version] nor a git URL"
	fi
}

cmd_remove() {
	(( $# >= 1 )) || die "Usage: $PROGRAM remove <name>"
	find_project
	local name="${1%.c3l}" dir f
	dir="$(lib_dir)" || exit 1; f="$dir/$name.c3l"
	[[ -n "$(lock_get "$name")" ]] || in_deps "$name" || [[ -e "$f" ]] || die "'$name' is not installed"
	[[ -n "$(lock_get "$name")" ]] || warn "$name is not tracked in $LOCK"
	local needed orphans
	needed="$(lock_dependents "$name" | paste -sd' ' -)"
	if [[ -n "$needed" ]] && (( ! FORCE )); then
		die "'$name' is required by: $needed. Remove those first, or use --force"
	fi
	if [[ -e "$f" ]]; then rm -rf "$f" && info "removed $f"; fi
	deps_edit del "$name" || warn "could not update $PROJECT; remove \"$name\" from 'dependencies' manually"
	lock_del "$name"
	info "removed $name"
	orphans="$(lock_orphans | paste -sd' ' -)"
	[[ -z "$orphans" ]] || info "no longer needed: $orphans (run '$PROGRAM prune' to remove)"
}

cmd_prune() {
	find_project
	local dir name orphans n=0
	dir="$(lib_dir)" || exit 1; orphans="$(lock_orphans)"
	[[ -n "$orphans" ]] && ! (( DRY_RUN )) && op_begin
	while IFS= read -r name; do
		[[ -n "$name" ]] || continue
		n=$((n+1))
		if (( DRY_RUN )); then printf '%s: not needed (dry run)\n' "$name"; continue; fi
		op_backup "$name"
		rm -rf "${dir:?}/$name.c3l"
		deps_edit del "$name" || warn "could not update $PROJECT; remove \"$name\" from 'dependencies' manually"
		lock_del "$name"
		info "pruned $name"
	done <<< "$orphans"
	op_commit
	(( n > 0 )) || info "nothing to prune"
	return 0
}

why_walk() { # name indent seen
	local n="$1" ind="$2" seen="$3" d
	while IFS= read -r d; do
		[[ -n "$d" ]] || continue
		if [[ " $seen " == *" $d "* ]]; then printf '%s%s requires %s (cycle)\n' "$ind" "$d" "$n"; continue; fi
		printf '%s%s requires %s\n' "$ind" "$d" "$n"
		why_walk "$d" "$ind  " "$seen $d"
	done < <(lock_dependents "$n")
}
cmd_why() {
	(( $# >= 1 )) || die "Usage: $PROGRAM why <name>"
	find_project
	local name="${1%.c3l}" rec role
	rec="$(lock_get "$name")"
	[[ -n "$rec" ]] || die "'$name' is not in $LOCK"
	IFS=$'\t' read -r _ _ _ _ _ _ role _ <<< "$rec"
	[[ "$role" == direct ]] && info "$name is a direct dependency of the project"
	why_walk "$name" "" "$name"
	return 0
}

tree_walk() { # name indent path
	local n="$1" ind="$2" path="$3" rec reqs r v
	rec="$(lock_get "$n")"
	IFS=$'\t' read -r _ _ _ _ _ _ _ reqs <<< "$rec"
	[[ -z "$reqs" || "$reqs" == - ]] && return 0
	for r in ${reqs//,/ }; do
		rec="$(lock_get "$r")"
		if [[ -n "$rec" ]]; then v="$(cut -f4 <<< "$rec")"; else v="(not installed)"; fi
		if [[ "$path" == *" $r "* ]]; then printf '%s%s %s (cycle)\n' "$ind" "$r" "$v"; continue; fi
		printf '%s%s %s\n' "$ind" "$r" "$v"
		tree_walk "$r" "$ind  " "$path$r "
	done
}
list_tree() {
	local name kind source version pin hash role reqs
	while IFS=$'\t' read -r name kind source version pin hash role reqs; do
		[[ "$role" == direct ]] || continue
		printf '%s %s\n' "$name" "$version"
		tree_walk "$name" "  " " $name "
	done < <(lock_entries)
}

cmd_list() {
	find_project
	(( TREE )) && { list_tree; return 0; }
	local dir deps name kind source version pin hash role reqs st n=0
	dir="$(lib_dir)" || exit 1; deps="$(deps_list)"
	while IFS=$'\t' read -r name kind source version pin hash role reqs; do
		[[ -n "$name" ]] || continue
		n=$((n+1))
		st="$(lib_status "$name" "$hash" "$dir" "$kind" "$pin")"
		grep -qx -- "$name" <<< "$deps" || st="$st,not-in-project"
		[[ "$role" == dep ]] && st="$st,dep"
		printf '%-20s %-8s %-12s %-10s %s\n' "$name" "$kind" "$version" "$st" "$source"
	done < <(lock_entries)
	while read -r name; do
		[[ -n "$name" ]] || continue
		[[ -n "$(lock_get "$name")" ]] && continue
		n=$((n+1))
		printf '%-20s %-8s %-12s %-10s %s\n' "$name" "-" "-" "untracked" "(in $PROJECT, not in $LOCK)"
	done <<< "$deps"
	(( n > 0 )) || info "no libraries (add one with '$PROGRAM add <ns/name>')"
	return 0
}

cmd_verify() {
	find_project
	local dir name kind source version pin hash role reqs st bad=0 n=0 d r
	dir="$(lib_dir)" || exit 1
	[[ -f "$LOCK" ]] || die "$LOCK not found"
	while IFS=$'\t' read -r name kind source version pin hash role reqs; do
		n=$((n+1))
		st="$(lib_status "$name" "$hash" "$dir" "$kind" "$pin")"
		if [[ "$st" != ok ]]; then printf '%s: %s\n' "$name" "$st" >&2; bad=1; fi
		for r in ${reqs//,/ }; do
			[[ "$r" == - ]] && continue
			[[ -n "$(lock_get "$r")" ]] || in_deps "$r" || { printf '%s: requires %s, which is not installed\n' "$name" "$r" >&2; bad=1; }
		done
	done < <(lock_entries)
	while read -r d; do
		[[ -n "$d" && -z "$(lock_get "$d")" ]] && { printf '%s: in %s but not in %s\n' "$d" "$PROJECT" "$LOCK" >&2; bad=1; }
	done < <(deps_list)
	(( bad )) && die "verification failed"
	info "$n librar$([[ $n == 1 ]] && echo y || echo ies) verified"
}

cmd_outdated() {
	find_project
	local name kind source version pin hash role reqs latest n=0
	while IFS=$'\t' read -r name kind source version pin hash role reqs; do
		latest="$(latest_for "$kind" "$source" "$version" "$pin")"
		[[ -n "$latest" ]] || continue
		if [[ "$latest" == HEAD@* ]] || semver_gt "$latest" "$version"; then
			printf '%-20s %-12s -> %s\n' "$name" "$version" "$latest"; n=$((n+1))
		fi
	done < <(lock_entries)
	(( n > 0 )) || info "everything is up to date"
	return 0
}

cmd_update() {
	find_project
	local -a names=("$@")
	local name kind source version pin hash role reqs latest rec n=0
	INSTALL_ROLE=keep   # updating never changes whether a library is direct
	if (( ${#names[@]} == 0 )); then while IFS=$'\t' read -r name _; do names+=("$name"); done < <(lock_entries); fi
	for name in ${names[@]+"${names[@]}"}; do
		local want=""
		if [[ "$name" == *@* ]]; then want="${name#*@}"; name="${name%%@*}"; [[ -n "$want" ]] || die "empty version in '$name@'"; fi
		rec="$(lock_get "${name%.c3l}")"
		[[ -n "$rec" ]] || { warn "$name is not in $LOCK"; continue; }
		IFS=$'\t' read -r name kind source version pin hash role reqs <<< "$rec"
		[[ "$kind" == git ]] && TRUSTED_HOSTS+=" $(url_host "$source") "
		if [[ -n "$want" ]]; then # explicit target: switch to that version/ref
			if (( DRY_RUN )); then printf '%s: %s -> %s (dry run)\n' "$name" "$version" "$want"; n=$((n+1)); continue; fi
			case "$kind" in
				registry) install_registry "$source" "$want" "" ;;
				git) install_git "$source" "$want" "" ;;
			esac
			n=$((n+1)); continue
		fi
		latest="$(latest_for "$kind" "$source" "$version" "$pin")"
		[[ -n "$latest" ]] || { warn "$name: cannot determine the newest version"; continue; }
		if [[ "$latest" == HEAD@* ]] || semver_gt "$latest" "$version"; then
			if (( DRY_RUN )); then printf '%s: %s -> %s (dry run)\n' "$name" "$version" "$latest"; n=$((n+1)); continue; fi
			case "$kind" in
				registry) install_registry "$source" "$latest" "" ;;
				git) if [[ "$latest" == HEAD@* ]]; then install_git "$source" "$version" ""; else install_git "$source" "$latest" ""; fi ;;
			esac
			n=$((n+1))
		fi
	done
	(( n > 0 )) || info "nothing to update"
	return 0
}

cmd_sync() {
	find_project
	[[ -f "$LOCK" ]] || die "$LOCK not found (nothing to sync; try '$PROGRAM migrate' or '$PROGRAM add')"
	local dir name kind source version pin hash role reqs st d drift=0
	dir="$(lib_dir)" || exit 1
	if (( FROZEN )); then
		while read -r d; do
			[[ -n "$d" && -z "$(lock_get "$d")" ]] && { printf 'drift: %s is in %s but not in %s\n' "$d" "$PROJECT" "$LOCK" >&2; drift=1; }
		done < <(deps_list)
		while IFS=$'\t' read -r name _; do
			in_deps "$name" || { printf 'drift: %s is in %s but not in %s\n' "$name" "$LOCK" "$PROJECT" >&2; drift=1; }
		done < <(lock_entries)
		(( drift )) && die "project and lockfile disagree (--frozen)"
		NOLOCKWRITE=1
	fi
	while IFS=$'\t' read -r name kind source version pin hash role reqs; do
		st="$(lib_status "$name" "$hash" "$dir" "$kind" "$pin")"
		if [[ "$st" == ok ]]; then
			in_deps "$name" || { info "registering $name in $PROJECT"; deps_edit add "$name" || die "could not register $name in $PROJECT"; }
			continue
		fi
		[[ "$st" == modified ]] && warn "$name differs from the lockfile; restoring"
		case "$kind" in
			registry) install_registry "$source" "$version" "$pin" ;;
			git) install_git "$source" "$version" "$pin" ;;
			*) die "unknown source kind '$kind' for $name" ;;
		esac
	done < <(lock_entries)
	info "in sync with $LOCK"
}

cmd_search() {
	(( $# >= 1 )) || die "Usage: $PROGRAM search <text|tag:name>"
	need curl
	local q="$*" url tag="" out
	if [[ "$q" == tag:* ]]; then tag="${q#tag:}"; q=""; fi
	url="$(registry)/search?q=$(printf '%s' "$q" | sed 's/ /%20/g')"
	[[ -n "$tag" ]] && url="$url&tag=$tag"
	if out="$(curl -fsS -m 30 "$url" 2>/dev/null)" && [[ "$out" == \{* ]]; then
		if command -v jq >/dev/null 2>&1; then
			jq -r '.libraries[] | [.library, .latest, .description] | @tsv' <<< "$out" | awk -F'\t' '{printf "%-32s %-10s %s\n",$1,$2,$3}'
			jq -r '"(\(.libraries|length) of \(.total // (.libraries|length)) shown)"' <<< "$out"
		else
			printf '%s\n' "$out"
		fi
	else
		c3_has_fetch || die "search failed and this c3c has no fetch-list"
		c3fetch fetch-list "$q"
	fi
}

cmd_info() {
	(( $# >= 1 )) || die "Usage: $PROGRAM info <namespace>/<name>"
	c3_has_fetch || die "this c3c has no 'fetch-info'"
	local text latest
	text="$(c3fetch fetch-info "$1")" || return 1
	printf '%s\n' "$text"
	latest="$(info_latest <<< "$text")"
	[[ -n "$latest" ]] && compat_check "$1" "$latest"
	return 0
}

cmd_check() {
	pub_check "${1:-.}"
	(( ERRS == 0 )) || exit 1
}

cmd_pack() {
	OFFLINE=1
	pub_check "${1:-.}"
	(( ERRS == 0 )) || die "not packing: $ERRS problem(s) found"
	local out="${OUTPUT_OPT:-$PWD/$PUB_NAME-$PUB_VERSION.c3l}"
	pub_stage; pub_zip "$PUB_STAGE" "$out"
	info "packed $out (sha256:$(sha256_file "$out"))"
}

cmd_publish() {
	local file sha idx got
	be_type_name >/dev/null
	be can_publish || be publish "" "" "" ""   # dies with the registry's own explanation
	pub_check "${1:-.}"
	(( ERRS == 0 )) || die "not publishing: $ERRS problem(s) found"
	tmproot
	file="$TMPROOT/$PUB_NAME-$PUB_VERSION.c3l"
	pub_stage; pub_zip "$PUB_STAGE" "$file"
	sha="$(sha256_file "$file")"
	if (( DRY_RUN )); then
		info "dry run: would publish $PUB_NAME $PUB_VERSION (C3 $PUB_C3V, sha256:$sha) to $(registry)"
		return 0
	fi
	info "publishing $PUB_NAME $PUB_VERSION to $(registry)"
	be publish "$PUB_NAME" "$PUB_VERSION" "$file" "$PUB_C3V"
	idx="$(be index "$PUB_NAME" "$PUB_VERSION")" && got="$(json_string_field sha256_file <<< "$idx")"
	got="${got#sha256:}"
	if [[ -z "$got" ]]; then warn "published, but the registry does not report a checksum yet; verify with 'c3l info'"
	elif [[ "$got" != "$sha" ]]; then die "published, but the registry's checksum ($got) differs from the uploaded file ($sha)"
	else info "published $PUB_NAME $PUB_VERSION (registry checksum matches sha256:$sha)"; fi
}

# c3po (Ecoral360/c3po) keeps project.lock.json: {"packages":[{name, repo, origin, ref, commit}]}.
# Read it and lock the same commits as git libraries. Nothing is written back to c3po.
migrate_c3po() {
	local dir name repo origin ref commit url label file hash
	dir="$(lib_dir)" || exit 1
	: | lock_write ""
	while IFS=$'\t' read -r name repo origin ref commit; do
		[[ -n "$name" && "$commit" =~ ^[0-9a-fA-F]{40}$ ]] || { warn "skipping a c3po entry without name or commit"; continue; }
		case "$origin" in
			github) url="https://github.com/$repo" ;;
			codeberg) url="https://codeberg.org/$repo" ;;
			*) warn "$name: unknown c3po origin '$origin', skipping"; continue ;;
		esac
		[[ "$ref" == - ]] && label=HEAD || label="$ref"
		hash="commit:$commit"
		file="$dir/$name.c3l"; [[ -e "$file" ]] || file="$dir/${repo##*/}"
		lock_put "$name" git "$url" "$label" "commit:$commit" "$hash" direct
		if [[ -e "$file" ]]; then read_reqs "$name" "$file"; lock_put "$name" git "$url" "$label" "commit:$commit" "$hash" keep "$REQ_NAMES"; fi
		info "imported $name ($label, commit ${commit:0:12}) from project.lock.json"
	done < <(json_flatten < project.lock.json | awk -F'\t' '
		$1 ~ /^packages\[[0-9]+\]\.(name|repo|origin|ref|commit)$/ { i = $1; sub(/^packages\[/, "", i); sub(/\].*/, "", i); k = $1; sub(/.*\./, "", k); r[i, k] = $2; if (!(i in s)) { s[i] = 1; o[++n] = i } }
		END { for (j = 1; j <= n; j++) { i = o[j]; print r[i, "name"] "\t" r[i, "repo"] "\t" r[i, "origin"] "\t" (r[i, "ref"] == "" ? "-" : r[i, "ref"]) "\t" r[i, "commit"] } }')
	info "libraries restored by c3po have no commit stamp; run '$PROGRAM sync' to rebuild them as verified archives"
}

cmd_migrate() {
	find_project
	if [[ ! -f "$OLDRECORDS" && -f project.lock.json ]]; then
		[[ -f "$LOCK" ]] && die "$LOCK already exists"
		migrate_c3po; return $?
	fi
	[[ -f "$OLDRECORDS" ]] || die "neither $OLDRECORDS (c3l 0.x) nor project.lock.json (c3po) found"
	[[ -f "$LOCK" ]] && die "$LOCK already exists"
	need git
	local dir name path url tag commit hash f
	dir="$(lib_dir)" || exit 1
	: | lock_write ""
	while read -r name path url tag; do
		[[ -n "$name" ]] || continue
		name="${name%.c3l}"
		f="$dir/$name.c3l"
		[[ -f "$f" ]] || { warn "$f missing, skipping $name (re-add it with '$PROGRAM add')"; continue; }
		[[ -n "$tag" ]] || tag="HEAD"
		if [[ "$tag" == HEAD ]]; then commit="$(git_head "$url")"
		else commit="$(git_tags "$url" | awk -v t="$tag" '$1==t{print $2; exit}')"; fi
		[[ -n "$commit" ]] || { warn "cannot resolve $url@$tag, skipping $name"; continue; }
		hash="commit:$commit"
		lock_put "$name" git "$url" "$tag" "commit:$commit" "$hash"
		info "migrated $name ($tag, commit ${commit:0:12}); commit pin resolved now, not at install time"
	done < "$OLDRECORDS"
	mv "$OLDRECORDS" "$OLDRECORDS.migrated" && info "$OLDRECORDS renamed to $OLDRECORDS.migrated"
}

